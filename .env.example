# Copy this file to .env and fill in your bot token
DISCORD_TOKEN=your-bot-token-here

# Also ban yesterday's answer (true/false)
CHECK_YESTERDAY=true

# Detection layers (all default true). Turn one off if it causes too many false deletes.
CATCH_SUFFIXES=true      # wagers, wagered, wagering
CATCH_PHONETIC=true      # wayjer, waygur (non-dictionary words that sound like the answer)
CATCH_FUZZY=true         # anagrams, one-letter typos, vowel removal, doubled/interleaved letters (non-dictionary only)
CATCH_CIPHERS=true       # caesar shifts, atbash, base64, hex, binary, a=1..z=26, morse, NATO
CATCH_ACROSTICS=true     # "wife angle grey ear red", "wage and real" (can misfire, e.g. "star every" on a "stare" day)

# ---- LLM layer (catches hints, riddles, synonyms, translations, solved-grid screenshots) ----
# Get a key at https://console.anthropic.com/settings/keys . Leave blank to run without the LLM layer.
ANTHROPIC_API_KEY=
# suspicious = only messages that look Wordle-related, or any message in a channel where Wordle was
#              mentioned in the last 10 minutes (recommended). all = every message. off = disabled.
LLM_MODE=suspicious
# Model to use. claude-opus-5 is the most accurate. claude-sonnet-5 or claude-haiku-4-5 are cheaper.
LLM_MODEL=claude-opus-5
# Delete "hint" verdicts at or above this confidence (0-1). Lower = stricter, more false deletes.
LLM_HINT_THRESHOLD=0.7
# Also send image attachments to the model (catches solved-grid screenshots OCR misses)
LLM_VISION=true

# ---- Audio layer (transcribes voice messages, audio files, and the soundtrack of videos, then scans the text) ----
# Get a key at https://platform.openai.com/api-keys . Leave blank to run without the audio layer.
OPENAI_API_KEY=
TRANSCRIBE_AUDIO=true
# gpt-4o-transcribe (most accurate), gpt-4o-mini-transcribe (cheaper), whisper-1. Roughly $0.003-0.006 per minute of audio.
AUDIO_MODEL=gpt-4o-transcribe
# Only the first N seconds of each clip are transcribed (cost cap)
AUDIO_MAX_SECONDS=600

# ---- GIF tags (looks up Tenor/Giphy links on their APIs: tags and descriptions the URL slug does not carry) ----
# Tenor: https://developers.google.com/tenor/guides/quickstart . Giphy: https://developers.giphy.com/dashboard/ . Leave blank to check GIF links by URL only.
TENOR_API_KEY=
GIPHY_API_KEY=

# Scan images/screenshots with OCR (downloads ~4MB language data on first run)
OCR_IMAGES=true
# Also OCR every frame of gifs, gif link previews and videos (ffmpeg splits them; plain OCR reads only the first frame)
OCR_FRAMES=true
# Frames sampled per clip after dropping near-duplicates
OCR_MAX_FRAMES=20

# On startup, scan the last 50 messages of every channel for spoilers posted while the bot was offline
SCAN_BACKLOG=true

# Rename members whose shown name (nickname, global name or username) contains the answer (needs Server Members Intent + Manage Nicknames)
POLICE_NICKNAMES=true

# Comma-separated channel IDs where spoilers are allowed (e.g. a dedicated wordle channel)
ALLOWED_CHANNEL_IDS=
